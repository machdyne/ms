(load "harness.l")

(check "string equality" (equal? "hello" "hello") #t)
(check "string inequality" (equal? "hello" "world") #f)
(check "str-append" (str-append "foo" "bar") "foobar")
(check "str-append many" (str-append "a" "b" "c" "d") "abcd")
(check "string-append (R4RS name)" (string-append "foo" "bar") "foobar")
(check "str-length" (str-length "hello") 5)
(check "string-length (R4RS name)" (string-length "hello") 5)
(check "str->num" (str->num "42") 42)
(check "str->num float" (str->num "3.5") 3.5)
(check "num->str" (num->str 42) "42")
(check "str->list" (str->list "ab") (list 'a 'b))
(check "list->str" (list->str (list 'h 'i)) "hi")
(check "string? true" (string? "x") #t)
(check "string? false" (string? 'x) #f)
(check "symbol? true" (symbol? 'x) #t)
(check "symbol? false" (symbol? "x") #f)
(check "number? true" (number? 5) #t)
(check "number? false" (number? "5") #f)

; string escapes in the reader
(check "escaped newline" (str-length "a\nb") 3)
(check "escaped quote" (str-length "a\"b") 3)

; --- R4RS string procedures ---
(check "make-string" (make-string 3 #\x) "xxx")
(check "string constructor" (string #\h #\i) "hi")
(check "string-ref" (string-ref "hello" 1) #\e)
(check "string-set!" (let ((s (string-copy "hello"))) (string-set! s 0 #\H) s) "Hello")
(check "substring" (substring "hello world" 0 5) "hello")
(check "string-copy independence"
  (let ((a "hello")) (let ((b (string-copy a))) (string-set! b 0 #\H) (list a b)))
  (list "hello" "Hello"))
(check "string=?" (string=? "abc" "abc") #t)
(check "string<?" (string<? "abc" "abd") #t)
(check "string>?" (string>? "abd" "abc") #t)
(check "string->symbol" (string->symbol "foo") 'foo)
(check "symbol->string" (symbol->string 'foo) "foo")
(check "number->string" (number->string 42) "42")
(check "number->string radix" (number->string 255 16) "ff")
(check "string->number" (string->number "42") 42)
(check "string->number radix" (string->number "ff" 16) 255)
(check "string->number invalid" (string->number "not-a-number") #f)

(report)
